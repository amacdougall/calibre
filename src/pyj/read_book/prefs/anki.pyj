from __python__ import bound_methods, hash_literals

from elementmaker import E

from book_list.globals import get_session_data
from dom import unique_id
from gettext import gettext as _
from read_book.globals import current_book
from read_book.prefs.utils import create_button_box
from session import session_defaults

CONTAINER = unique_id('anki-settings')
BOOK_DECK = unique_id('anki-book-deck')
BOOK_STRIP = unique_id('anki-book-strip-speaker')


def get_container():
    return document.getElementById(CONTAINER)


def restore_defaults():
    container = get_container()
    sd = session_defaults()
    for control in container.querySelectorAll('input[name]'):
        control.value = sd[control.getAttribute('name')]
    book_inp = document.getElementById(BOOK_DECK)
    if book_inp:
        book_inp.value = ''
    strip_inp = document.getElementById(BOOK_STRIP)
    if strip_inp:
        strip_inp.checked = False


def current_book_key():
    book = current_book()
    return book.anki_book_key if book else None


def create_anki_panel(container, apply_func, cancel_func):
    container.appendChild(E.div(id=CONTAINER, style='margin: 1rem'))
    container = container.lastChild
    sd = get_session_data()

    container.appendChild(E.div(
        _('Settings for mining cards into Anki while reading. Anki must be running with'
          ' the AnkiConnect add-on installed.')
    ))

    inp = E.input(type='text', name='anki_deck', size='40', style='margin-top: 1ex')
    inp.value = sd.get('anki_deck') or ''
    container.appendChild(E.div(
        style='margin-top: 2ex',
        E.label(_('Default Anki deck to add mined cards to:'), E.br(), inp)
    ))

    key = current_book_key()
    if key:
        book_inp = E.input(type='text', id=BOOK_DECK, size='40', style='margin-top: 1ex',
                           placeholder=_('Blank to use the default deck'))
        book_inp.value = (sd.get('anki_book_decks') or {})[key] or ''
        container.appendChild(E.div(
            style='margin-top: 2ex',
            E.label(_('Deck for this book ({}):').format(current_book().metadata.title), E.br(), book_inp)
        ))
        strip_inp = E.input(type='checkbox', id=BOOK_STRIP, style='margin-left: 0')
        strip_inp.checked = bool((sd.get('anki_book_strip_speaker_tags') or {})[key])
        container.appendChild(E.div(
            style='margin-top: 2ex',
            E.label(strip_inp, _('Omit speaker tags from dialogue lines in this book (e.g. 筆者\u3000…)'))
        ))

    container.appendChild(create_button_box(restore_defaults, apply_func, cancel_func))


develop = create_anki_panel


def commit_anki(onchange):
    sd = get_session_data()
    container = get_container()
    changed = False
    for control in container.querySelectorAll('input[name]'):
        name = control.getAttribute('name')
        val = (control.value or '').strip() or session_defaults()[name]
        if val is not sd.get(name):
            sd.set(name, val)
            changed = True
    key = current_book_key()
    book_inp = document.getElementById(BOOK_DECK)
    if key and book_inp:
        book_decks = Object.assign({}, sd.get('anki_book_decks') or {})
        val = (book_inp.value or '').strip()
        if val is not (book_decks[key] or ''):
            if val:
                book_decks[key] = val
            else:
                v'delete book_decks[key]'
            sd.set('anki_book_decks', book_decks)
            changed = True
    strip_inp = document.getElementById(BOOK_STRIP)
    if key and strip_inp:
        book_strip = Object.assign({}, sd.get('anki_book_strip_speaker_tags') or {})
        if strip_inp.checked is not bool(book_strip[key]):
            if strip_inp.checked:
                book_strip[key] = True
            else:
                v'delete book_strip[key]'
            sd.set('anki_book_strip_speaker_tags', book_strip)
            changed = True
    if changed:
        onchange()
